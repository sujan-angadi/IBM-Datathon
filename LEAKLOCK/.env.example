# LEAKLOCK — Optional Environment Configuration
# Default mode uses the built-in deterministic Mock Demo Provider ('mock').
# No API keys are required to run LEAKLOCK or execute the Datathon scenarios.

LEAKLOCK_PROVIDER_MODE=mock
# To connect an optional OpenAI-compatible endpoint, set:
# LEAKLOCK_PROVIDER_MODE=openai_compatible
# LEAKLOCK_API_KEY=your_api_key_here
# LEAKLOCK_API_BASE_URL=https://api.openai.com/v1/chat/completions
# LEAKLOCK_MODEL=gpt-4o-mini

MAX_PROMPT_LENGTH=10000
